# Build-time only: client/scripts/seo-build.mjs fetches the catalogue from here
# to generate the sitemap. The browser does NOT use this — it always talks to
# /api on its own origin (see client/vercel.json), because a cross-origin API
# makes the session cookies third-party and iOS drops those.
VITE_API_PROXY_TARGET=https://dearte-server.vercel.app/api
